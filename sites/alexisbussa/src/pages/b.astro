---
import "@fontsource-variable/source-sans-3/wght.css";
import ProjectBody from "../components/ProjectBody.astro";
import { formatDay, formatIsoDate } from "../lib/dates";
import { loadHomepage } from "../lib/homepage";
import Base from "../layouts/Base.astro";
import "../styles/b.css";

const { now, articles, projects, featured, updated } = await loadHomepage();
---

<Base title="Still life · Alexis Bussa" description={now.intro}>
  <main id="content" class="column">
    <p class="switch"><a href="/">Directions</a> · B, still life</p>
    <img class="still" src={now.visual.src} alt={now.visual.alt} width="900" height="740" />
    <h1>{now.lastSeenBuilding}</h1>
    <p class="updated">
      Updated <time datetime={now.updated}>{formatDay(updated)}</time>
    </p>
    <div class="rest">
      <p class="name">Alexis Bussa</p>
      <p>{now.intro}</p>
      <p>{now.activity}</p>
      <p>{now.where}</p>
      <p class="pointer">
        By the way, <a href={featured.data.mediumUrl} rel="external">{featured.data.title}</a>.
      </p>
      <p>{featured.data.hook}</p>
    </div>
    <section class="section" aria-labelledby="writing">
      <h2 id="writing">Writing</h2>
      <ul class="pieces">
        {
          articles.map((article) => (
            <li>
              <h3>
                <a href={article.data.mediumUrl} rel="external">
                  {article.data.title}
                </a>
              </h3>
              <p class="hook">{article.data.hook}</p>
              {article.data.image ? (
                <img class="piece-image" src={article.data.image} alt={article.data.title} />
              ) : null}
              <p class="meta">
                <time datetime={formatIsoDate(article.data.date)}>{formatDay(article.data.date)}</time>
                {" · "}
                <a href={article.data.mediumUrl} rel="external">
                  Medium
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="section" aria-labelledby="projects">
      <h2 id="projects">Projects</h2>
      <ul class="pieces">
        {
          projects.map((project) => (
            <li>
              <h3>
                {project.data.title}
              </h3>
              <p class="piece-status">{project.data.status}</p>
              <p class="summary">{project.data.summary}</p>
              <div class="body">
                <ProjectBody project={project} />
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
