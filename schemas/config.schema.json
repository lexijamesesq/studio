{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "vaultRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "packageRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "recordsPath": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publicUse": {
            "type": "string",
            "enum": [
              "private",
              "paraphrase",
              "quotable"
            ]
          }
        },
        "required": [
          "id",
          "publicUse"
        ],
        "additionalProperties": false
      }
    },
    "intentPaths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lessonPaths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "vaultRoot",
    "recordsPath",
    "sources",
    "intentPaths",
    "lessonPaths"
  ],
  "additionalProperties": false
}
